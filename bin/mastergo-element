#!/usr/bin/env bash
#
# MasterGo 元素分析器
# 用法：mastergo-element <url> <selector> [output-dir]
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
ANALYZER="$SCRIPT_DIR/mastergo-element.js"
OUTPUT_DIR="${3:-./mastergo-element-output}"

# 加载依赖检查库
source "$BASE_DIR/common/check-dependencies.sh"

# 显示帮助
show_help() {
    echo "MasterGo 元素分析器 - 精准分析原型中的特定组件"
    echo ""
    echo "用法：$0 <url> <selector> [output-dir]"
    echo ""
    echo "参数说明:"
    echo "  <url>       MasterGo 原型链接"
    echo "  <selector>  CSS 选择器（如：.button-primary, #login-form）"
    echo "  [output-dir] 输出目录（默认：./mastergo-element-output）"
    echo ""
    echo "示例:"
    echo "  $0 https://mastergo.com/xxx/yyy \".submit-btn\""
    echo "  $0 https://mastergo.com/xxx/yyy \"#header-nav\" ./output"
    echo ""
    echo "输出文件:"
    echo "  element-highlight.png    - 元素截图（带高亮）"
    echo "  page-with-highlight.png  - 页面截图（带高亮）"
    echo "  element-original.png     - 元素截图（原始）"
    echo "  element-info.json        - 元素详细信息"
    echo "  element.css              - CSS 代码片段"
    echo "  element.tailwind.txt     - Tailwind 类名"
    echo ""
    print_tip "提示:"
    echo "  1. 在 MasterGo 中使用开发者工具找到元素的选择器"
    echo "  2. 如果选择器找不到元素，尝试更简单的选择器"
    echo "  3. 可以使用浏览器开发者工具验证选择器是否正确"
}

# 主程序
if [ $# -lt 2 ]; then
    show_help
    exit 1
fi

# 检查依赖
check_dependencies "$SCRIPT_DIR"

print_status "开始分析元素..."
echo "  URL: $1"
echo "  选择器：$2"
echo "  输出目录：$OUTPUT_DIR"
echo ""

cd "$SCRIPT_DIR"
node "$ANALYZER" "$1" "$2" "$OUTPUT_DIR"
cd - > /dev/null

print_success "元素分析完成!"
