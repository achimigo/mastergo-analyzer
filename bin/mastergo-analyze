#!/usr/bin/env bash
#
# MasterGo 分析器 - 一键调用脚本
# 用法：mastergo-analyze <prototype-url> [output-dir]
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ANALYZER="$SCRIPT_DIR/mastergo-analyzer.js"
OUTPUT_DIR="${2:-./mastergo-output}"

# 颜色输出
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

print_status() { echo -e "${BLUE}[INFO]${NC} $1"; }
print_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
print_tip() { echo -e "${YELLOW}[TIP]${NC} $1"; }

# 检查依赖
check_dependencies() {
    if ! command -v node &> /dev/null; then
        echo -e "\033[0;31m[ERROR]\033[0m Node.js 未安装"
        exit 1
    fi

    # 检查本地 node_modules
    if [ ! -d "$SCRIPT_DIR/node_modules/playwright" ]; then
        print_status "安装 Playwright..."
        cd "$SCRIPT_DIR"
        npm install
        npx playwright install chromium
        cd - > /dev/null
    fi

    # 检查浏览器
    if ! npx playwright --version &>/dev/null; then
        print_status "安装 Chromium 浏览器..."
        cd "$SCRIPT_DIR"
        npx playwright install chromium
        cd - > /dev/null
    fi
}

# 主程序
main() {
    if [ -z "$1" ]; then
        echo "用法：mastergo-analyze <prototype-url> [output-dir]"
        echo ""
        echo "示例:"
        echo "  mastergo-analyze https://mastergo.com/xxx/yyy"
        echo "  mastergo-analyze https://mastergo.com/xxx/yyy ./output"
        echo ""
        echo "输出文件:"
        echo "  - screenshot.png       页面截图"
        echo "  - analysis.json        完整 DOM 结构和样式"
        echo "  - design-tokens.json   设计令牌 (颜色/字体/间距)"
        exit 1
    fi

    check_dependencies

    print_status "开始分析 MasterGo 原型..."
    echo "  URL: $1"
    echo "  输出目录：$OUTPUT_DIR"
    echo ""

    # 使用本地 node_modules 运行
    cd "$SCRIPT_DIR"
    node "$ANALYZER" "$1" "$OUTPUT_DIR"
    cd - > /dev/null

    echo ""
    print_success "分析完成!"
    echo ""
    print_tip "在 Claude Code 中使用:"
    echo "  1. 查看 mastergo-output/screenshot.png 了解布局"
    echo "  2. 读取 mastergo-output/design-tokens.json 获取设计令牌"
    echo "  3. 让 Claude Code 读取 analysis.json 实现代码"
}

main "$@"
