#!/usr/bin/env bash
#
# MasterGo 分析器 - 一键调用脚本
# 用法：mastergo-analyze <prototype-url> [output-dir]
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
ANALYZER="$SCRIPT_DIR/mastergo-analyzer.js"
OUTPUT_DIR="${2:-./mastergo-output}"

# 加载依赖检查库
source "$BASE_DIR/common/check-dependencies.sh"

# 显示帮助
show_help() {
    echo "MasterGo 分析器 - 整页设计分析"
    echo ""
    echo "用法：$0 <prototype-url> [output-dir]"
    echo ""
    echo "示例:"
    echo "  mastergo-analyze https://mastergo.com/xxx/yyy"
    echo "  mastergo-analyze https://mastergo.com/xxx/yyy ./output"
    echo ""
    echo "输出文件:"
    echo "  - screenshot.png       页面截图"
    echo "  - analysis.json        完整 DOM 结构和样式"
    echo "  - design-tokens.json   设计令牌 (颜色/字体/间距)"
    echo ""
    print_tip "在 Claude Code 中使用:"
    echo "  1. 查看截图了解整体布局"
    echo "  2. 读取 design-tokens.json 获取颜色和字体"
    echo "  3. 让 Claude Code 读取 analysis.json 实现代码"
}

# 主程序
if [ -z "$1" ]; then
    show_help
    exit 1
fi

if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    show_help
    exit 1
fi

# 检查依赖
check_dependencies "$SCRIPT_DIR"

print_status "开始分析 MasterGo 原型..."
echo "  URL: $1"
echo "  输出目录：$OUTPUT_DIR"
echo ""

cd "$SCRIPT_DIR"
node "$ANALYZER" "$1" "$OUTPUT_DIR"
cd - > /dev/null

print_success "分析完成!"
